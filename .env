# =================================================================
# SOLARCARE PLATFORM ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port
PORT=5000

# -----------------------------------------------------------------
# GMAIL SMTP CONFIGURATION (For sending real 6-digit OTP to user Gmail)
# -----------------------------------------------------------------
# IMPORTANT / ZAROORI HIDAYAT:
# Google does NOT accept your normal account password (jaise 'farhan0987') for SMTP!
# Agar aap normal account password lagayenge to Google "535 BadCredentials" error dega
# aur Gmail par email deliver nahi ho ga.
#
# Real emails apne Gmail inbox me receive karne ke liye 16-digit Google "App Password" banayein:
# 1. Google Account security kholein: https://myaccount.google.com/security
# 2. "2-Step Verification" ko Turn ON karein (ye lazmi hai).
# 3. Is direct link par jayein: https://myaccount.google.com/apppasswords
# 4. App Name me "SolarCare" likhein aur "Create" dabayein.
# 5. Google aap ko 16 letters ka code dega (e.g. abcd efgh ijkl mnop).
# 6. Wo 16-character code neechay GMAIL_APP_PASSWORD me paste karein:

GMAIL_USER=farhankhan61675@gmail.com
GMAIL_APP_PASSWORD=kfkb nvxb pdwb tbsq
# (Replace 'farhan0987' with your 16-character Google App Password to enable real Gmail delivery)

# DEV FALLBACK NOTICE:
# Jab tak 16-character App Password nahi lagaya jata, SolarCare server OTP code ko
# server terminal (black window) me print karega taa kay sign up aur forgot password testing
# kisi bhi waqt block na ho!

# Optional: Custom SMTP (if using another email provider)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="SolarCare Security" <noreply@solarcare.com>
