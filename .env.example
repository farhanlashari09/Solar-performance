# =================================================================
# SOLARCARE PLATFORM ENVIRONMENT CONFIGURATION EXAMPLE
# =================================================================

# Server Port
PORT=5000

# Only admin@solarcare.com is authorized for administrator-only features.

# -----------------------------------------------------------------
# GMAIL SMTP CONFIGURATION (For sending real 6-digit OTP to user Gmail)
# -----------------------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Windows Computer", and copy the 16-character code)
# 3. Paste your Gmail address and 16-character App Password below:

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: Custom SMTP (if using another email provider)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="SolarCare Security" <noreply@solarcare.com>

# -----------------------------------------------------------------
# HUAWEI FUSIONSOLAR NORTHBOUND API (server-side only)
# -----------------------------------------------------------------
# Use the HTTPS Northbound API host for the region/account. Keep these
# values in the backend environment; never add them to Vite/client variables.
FUSIONSOLAR_BASE_URL=https://intl.fusionsolar.huawei.com
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=
